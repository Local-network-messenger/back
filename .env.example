# Database Configuration
POSTGRES_DB=messenger_db
POSTGRES_USER=messenger_user
POSTGRES_PASSWORD=messenger_password
POSTGRES_PORT=5432

# Backend Service
BACKEND_PORT=8080
BACKEND_DEBUG_PORT=5005

# DB Service (gRPC)
DB_SERVICE_PORT=9090

# Database JDBC
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/messenger_db

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Log Level
LOGGING_LEVEL_ROOT=INFO
