<?xml version="1.0" encoding="UTF-8"?>
<profile version="12">
    <!-- Основные настройки табуляции -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
    
    <!-- Длина строки -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>
    
    <!-- Скобки -->
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_type_declaration" value="next_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_method_declaration" value="next_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_block" value="next_line"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_simple_if_on_one_line" value="false"/>
    
    <!-- Новые строки -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_at_end_of_file" value="true"/>
    
    <!-- Пробелы -->
    <setting id="org.eclipse.jdt.core.formatter.insert_space_after_comma_in_method_invocation_arguments" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_space_after_comma_in_method_declaration_parameters" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_space_after_semicolon_in_for" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_space_before_semicolon_in_for" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_space_before_opening_brace_in_method_declaration" value="true"/>
    
    <!-- Импорты -->
    <setting id="org.eclipse.jdt.core.formatter.import_order" value="java,javax,org,com"/>
    <setting id="org.eclipse.jdt.core.formatter.import_on_demand_threshold" value="999"/>
    <setting id="org.eclipse.jdt.core.formatter.remove_unused_imports" value="true"/>
</profile>
